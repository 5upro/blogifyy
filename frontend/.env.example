VITE_SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
VITE_WEB3_ACCESS_KEY= web3form-acess-key-here
VITE_API_BASE_URI=your backend uri
# reCAPTCHA v2 "Checkbox" site key. Must have your deployed domain whitelisted in the
# Google reCAPTCHA console. When unset in a production build, the widget is skipped.
VITE_RECAPTCHA_SITE_KEY=
# Razorpay key id is public and safe in the browser. Never put the key secret here.
VITE_RAZORPAY_KEY_ID=
